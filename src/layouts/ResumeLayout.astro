---
import "@/styles/global.css";
import "@/styles/typography.css";
import Head, { type Props as HeadProps } from "@/components/static/Head.astro";
import SmoothScroll from "@/components/static/SmoothScroll.astro";

const headProps = Astro.props as HeadProps;
---

<!doctype html>
<html lang="en" class="dark" data-theme="oled-dark">
    <Head {...headProps} />
    <SmoothScroll />

    <body class="mx-auto" data-pagefind-ignore={headProps.noindex ? "all" : undefined}>
        {/* Content */}
        <main class="max-w-4xl mx-auto">
            <slot />
        </main>
    </body>
</html>
