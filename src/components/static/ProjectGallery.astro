---
import type { ImageMetadata } from "astro";
import type { projectConfig } from "@/lib/types";
import ProjectGallery from "@/components/client/ProjectGallery";

export interface Props {
    item: projectConfig;
    images: ImageMetadata[];
}

const { item, images } = Astro.props;
const videoId = item.video ? extractVimeoId(item.video) : null;

function extractVimeoId(url: string): string | null {
    if (!url) return null;
    const regex = /vimeo\.com\/(?:video\/)?(\d+)/;
    const match = url.match(regex);
    return match ? match[1] : null;
}

const galleryImages = images.map((img, i) => ({
    src: img.src,
    alt: `${item.data.title} gallery image ${i + 1}`,
}));
---

<div class="border border-border p-6">
    {(images.length > 0 || videoId) && <ProjectGallery images={galleryImages} videoId={videoId} title={item.data.title} client:load />}
</div>
