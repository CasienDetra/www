---
import { buttonVariants } from "../ui/button";
import { RiArrowRightLine } from "@remixicon/react";
import site_config from "@/site-config.json";
import type { siteConfig } from "@/lib/types";
import { SocialIcon, SubHeadingIcon } from "@/lib/icons";
import ScrambledText from "../client/ScrambledText";
import { Tilt } from "../client/Tilt";
import { Image } from "astro:assets";
import pic from "@/assets/pic.jpg";
import piconbg from "@/assets/pic-no_bg.png";
---

<section class="border border-border bg-background p-6">
    <!-- Image + badge + heading -->
    <div class="flex items-center gap-5">
        <div class="hidden shrink-0 md:block">
            <Tilt maxTilt={3} client:load>
                <Image
                    src={piconbg}
                    alt={`Portrait of ${site_config.introduction.heading}`}
                    loading="eager"
                    class="size-28 aspect-square select-none rounded-xl border border-border object-cover animate-pan"
                />
            </Tilt>
        </div>

        <div class="min-w-0 flex-1">
            <!-- Badges -->
            {
                site_config.introduction.badges && (
                    <div class="mb-3 flex flex-wrap gap-2 select-none">
                        {site_config.introduction.badges.map((badge) => (
                            <span class="rounded-sm border border-muted-foreground/30 px-3 py-1">
                                <span class="text-xs opacity-80">{badge}</span>
                            </span>
                        ))}
                    </div>
                )
            }

            <!-- Heading -->
            <h1 class="text-2xl font-semibold opacity-90 sm:text-5xl">
                {site_config.introduction.heading}
            </h1>
        </div>
    </div>

    <!-- Everything below the heading remains here -->
    <div class="mt-8">
        <!-- Subheading items -->
        <div class="flex flex-col gap-1 select-none">
            {
                site_config.introduction.subHeadingItems &&
                    site_config.introduction.subHeadingItems.map((item) => (
                        <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex w-fit items-center gap-3 opacity-80 animation hover:opacity-100"
                        >
                            <SubHeadingIcon
                                type={item.type as siteConfig["introduction"]["subHeadingItems"][number]["type"]}
                            />

                            <p class="text-sm leading-relaxed md:text-base">
                                {item.label}
                            </p>
                        </a>
                    ))
            }
        </div>

        <!-- Social links -->
        <div class="mt-5 flex gap-3">
            {
                site_config.introduction.socialItems &&
                    site_config.introduction.socialItems.map((item) => (
                        <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={item.type}
                        >
                            <SocialIcon
                                type={item.type as siteConfig["introduction"]["socialItems"][number]["type"]}
                                className="size-8 text-secondary-foreground/80 hover:text-foreground"
                            />
                        </a>
                    ))
            }
        </div>

        <!-- Description -->
        <ScrambledText
            radius={60}
            className="py-6 text-base leading-relaxed text-secondary-foreground/80 md:text-lg"
            client:load
        >
            {site_config.introduction.description}
        </ScrambledText>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-3">
            {
                site_config.introduction.ctaItems &&
                    site_config.introduction.ctaItems.map((cta) => (
                        <a
                            href={cta.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={`${buttonVariants({
                                variant: cta.variant as siteConfig["introduction"]["ctaItems"][number]["variant"],
                                size: "default",
                            })} group`}
                        >
                            <span class="text-sm leading-relaxed opacity-90">
                                {cta.label}
                            </span>

                            <RiArrowRightLine className="size-0 animation group-hover:size-4" />
                        </a>
                    ))
            }

            {
                site_config.introduction.support && (
                    <a
                        href={site_config.introduction.support.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`${buttonVariants({
                            variant: site_config.introduction.support.variant as siteConfig["introduction"]["ctaItems"][number]["variant"],
                            size: "default",
                        })} group`}
                    >
                        <span class="text-sm leading-relaxed opacity-90">
                            {site_config.introduction.support.label}
                        </span>
                    </a>
                )
            }
        </div>
    </div>
</section>
