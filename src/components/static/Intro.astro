---
import { RiArrowDownSLine } from "@remixicon/react";

const bioLines = ["I'm Yanouk","love design and build stuff", "I make things", "and tell its story.", "I use Arch btw"];
---

<section id="intro" class="flex min-h-[calc(100dvh-2.5rem)] flex-col items-center justify-center gap-16 px-6 md:px-16">
    <div class="select-none w-full max-w-xl mx-auto font-mono leading-loose">
        {bioLines.map((line) => (
            <p class="text-sm md:text-xl text-primary font-bold">$ {line}</p>
        ))}
    </div>
    <a href="#introduction" class="text-sm text-secondary-foreground/80 hover:text-foreground animation">
        more about me <RiArrowDownSLine className="inline size-4 animate-bounce" />
    </a>
</section>

<script>
    const intro = document.getElementById("intro");
    const header = document.querySelector("header");
    if (intro && header) {
        new IntersectionObserver(([entry]) => {
            header.classList.toggle("hidden", entry.isIntersecting);
        }).observe(intro);
    }
</script>
