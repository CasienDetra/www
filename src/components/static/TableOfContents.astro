---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
    toc.length > 0 && (
        <nav aria-label="On this page" class="toc hidden lg:block w-56 shrink-0">
            <p class="mb-3 text-sm font-medium text-foreground">On this page</p>
            <ul>
                {toc.map((heading) => (
                    <li>
                        <a
                            href={`#${heading.slug}`}
                            data-toc-link={heading.slug}
                            class:list={[
                                "toc-link animation group flex items-center gap-3 py-1.5 text-sm",
                                "text-muted-foreground hover:text-foreground",
                                heading.depth === 3 && "pl-7",
                            ]}
                        >
                            <span
                                class="w-0.5 self-stretch rounded-full bg-foreground opacity-0 transition-opacity duration-150 group-aria-[current=location]:opacity-100"
                                aria-hidden="true"
                            />
                            <span class="group-aria-[current=location]:font-semibold group-aria-[current=location]:text-foreground">{heading.text}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}

<style>
    :global(h2),
    :global(h3) {
        scroll-margin-top: 8rem;
    }

    .toc {
        position: sticky;
        top: 8rem;
        align-self: start;
        max-height: calc(100vh - 10rem);
        overflow-y: auto;
    }
</style>

<script>
    let observer: IntersectionObserver | undefined;
    let resizeObserver: ResizeObserver | undefined;

    function initScrollspy() {
        observer?.disconnect();
        resizeObserver?.disconnect();

        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
        );

        if (!links.length) return;

        const sections = links
            .map((link) => {
                const id = decodeURIComponent(link.hash.slice(1));
                const element = document.getElementById(id);

                return element ? { id, element } : null;
            })
            .filter(
                (section): section is { id: string; element: HTMLElement } =>
                    section !== null,
            );

        if (!sections.length) return;

        const setActive = (id: string) => {
            for (const link of links) {
                const isActive = link.dataset.tocLink === id;

                if (isActive) {
                    link.setAttribute("aria-current", "location");
                } else {
                    link.removeAttribute("aria-current");
                }
            }
        };

        const getHeaderHeight = () => {
            const header = document.querySelector("header");
            return header?.getBoundingClientRect().height ?? 0;
        };

        const createObserver = () => {
            observer?.disconnect();

            const headerHeight = getHeaderHeight();

            observer = new IntersectionObserver(
                (entries) => {
                    const visibleSections = entries
                        .filter((entry) => entry.isIntersecting)
                        .sort(
                            (a, b) =>
                                a.boundingClientRect.top -
                                b.boundingClientRect.top,
                        );

                    if (visibleSections.length > 0) {
                        const activeSection = visibleSections[0].target.id;
                        setActive(activeSection);
                    }
                },
                {
                    // Start observing below the sticky header.
                    rootMargin: `-${headerHeight + 16}px 0px -65% 0px`,
                    threshold: 0,
                },
            );

            for (const { element } of sections) {
                observer.observe(element);
            }
        };

        createObserver();

        resizeObserver = new ResizeObserver(createObserver);

        const header = document.querySelector("header");
        if (header) {
            resizeObserver.observe(header);
        }
    }

    document.addEventListener("astro:page-load", initScrollspy);
</script>
