---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
    toc.length > 0 && (
        <nav aria-label="On this page" class="toc hidden lg:block w-56">
            <p class="mb-3 text-sm font-medium text-foreground">On this page</p>
            <div class="relative">
                <svg
                    class="pointer-events-none absolute top-0 left-0 h-full w-full overflow-visible"
                    viewBox="0 0 10 100"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <path
                        class="toc-rail"
                        d=""
                        fill="none"
                        vector-effect="non-scaling-stroke"
                    />
                    <path
                        class="toc-indicator opacity-0"
                        d=""
                        fill="none"
                        vector-effect="non-scaling-stroke"
                        data-toc-indicator
                    />
                </svg>
                <ul>
                    {toc.map((heading) => (
                        <li>
                            <a
                                href={`#${heading.slug}`}
                                data-toc-link={heading.slug}
                                title={heading.text}
                                class:list={[
                                    "toc-link animation group flex items-center gap-3 py-1.5 text-sm",
                                    "text-muted-foreground hover:text-foreground",
                                    heading.depth === 3 && "pl-7",
                                ]}
                            >
                                <span
                                    class="w-0.5 shrink-0 self-stretch"
                                    data-toc-marker
                                    aria-hidden="true"
                                />
                                <span class="min-w-0 truncate group-aria-[current=location]:font-semibold group-aria-[current=location]:text-foreground">
                                    {heading.text}
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </nav>
    )
}
<style>
    :global(h2),
    :global(h3) {
        scroll-margin-top: 8rem;
    }

    /* * FLOATING SCROLLSPY */
    /* ------------------------------------------------------------------ *
     * Detached card floating right of the article while it scrolls.
     *
     *   left     min(50% + 448px + 24px, 100vw - 240px)
     *              - the column is max-w-4xl (896px), so 448px is its
     *                half: the card rests 24px right of the article
     *                border on wide screens.
     *              - the clamp keeps the card 16px from the viewport
     *                edge; below ~1390px it overlaps the article's
     *                right edge instead of clipping off-screen.
     *                1147px window: min(1045px, 907px) = 907px.
     *                1024px window: min(984px, 784px) = 784px.
     *   top      50% + translateY(-50%) - vertically centered float,
     *                clear of the 42px sticky header + 8px offset.
     *
     * Card chrome (solid background + border) is what makes the overlap
     * read as intentional. Re-check these numbers if max-w-4xl, the
     * header height or w-56 changes.
     * ------------------------------------------------------------------ */
    .toc {
        position: fixed;
        top: 50%;
        left: min(calc(50% + 448px + 1.5rem), calc(100vw - 15rem));
        transform: translateY(-50%);
        z-index: 50;
        max-height: calc(100vh - 8rem);
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem;
        background: var(--background);
        border: 1px solid var(--border);
    }

    /* * TOC RAIL */
    /* ------------------------------------------------------------------ *
     * The rail is an SVG path that snakes down the list, jogging right
     * for nested h3 links. The thumb is the same path: a dash pattern
     * spanning its full length, rolled back with stroke-dashoffset so
     * it reads as the gray rail re-inked up to the active heading.
     *
     * JS builds the path in pixel space and sizes the viewBox to match,
     * so one unit is one pixel; non-scaling-stroke keeps the 2px stroke
     * uniform, and the offset transition is what glides the thumb
     * between sections. Re-check the elbow geometry in pathFor() if
     * pl-7 or the link padding changes.
     * ------------------------------------------------------------------ */
    .toc-rail {
        stroke: var(--border);
        stroke-width: 2px;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ------------------------------------------------------------------ *
     * Thumb reveal. The dash pattern spans the whole path, and
     * stroke-dashoffset rolls the reveal edge back, so one eased
     * transition glides the thumb between sections instead of snapping
     * to a new path. First placement and reflows snap (data-instant).
     * ------------------------------------------------------------------ */
    .toc-indicator {
        stroke: var(--foreground);
        stroke-width: 2px;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition:
            stroke-dashoffset 450ms var(--ease-out),
            opacity 200ms linear;
    }

    .toc-indicator[data-instant] {
        transition: none;
    }
</style>

<script>
    type Section = {
        element: HTMLElement;
        link: HTMLAnchorElement;
        /** Marker slot the rail passes through for this heading. */
        marker: HTMLElement;
        index: number;
        /** Scroll offset the heading rests at when navigated to directly. */
        offset: number;
    };

    let resizeObserver: ResizeObserver | undefined;
    let teardown: (() => void) | undefined;

    function initScrollspy() {
        teardown?.();
        teardown = undefined;
        resizeObserver?.disconnect();

        const indicator = document.querySelector<SVGPathElement>(
            "[data-toc-indicator]",
        );
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
        );

        if (!indicator || !links.length) return;

        const svg = indicator.ownerSVGElement;
        const rail = svg?.querySelector<SVGPathElement>(".toc-rail");
        if (!svg || !rail) return;

        const sections = links
            .map((link, index) => {
                const id = decodeURIComponent(link.hash.slice(1));
                const element = document.getElementById(id);
                const marker =
                    link.querySelector<HTMLElement>("[data-toc-marker]") ??
                    link;

                return element
                    ? { element, link, marker, index, offset: 0 }
                    : null;
            })
            .filter((section): section is Section => section !== null);

        if (!sections.length) return;

        // A heading becomes current exactly where it lands when its anchor is
        // followed, so the highlight and anchor navigation can't disagree.
        const measure = () => {
            for (const section of sections) {
                const margin = Number.parseFloat(
                    getComputedStyle(section.element).scrollMarginTop,
                );

                section.offset = Number.isNaN(margin) ? 0 : margin;
            }
        };

        let active: Section | undefined;
        let last = -1;
        let snapNext = true;

        // Builds the snaking rail: vertical through each heading's marker
        // slot, jogging sideways in the padding band between two rows and
        // back after it, then running to the list bottom like a scrollbar
        // track. Both paths share this d; the thumb is revealed by its
        // dash pattern, not re-drawn.
        type RailPt = {
            cx: number;
            cy: number;
            top: number;
            bottom: number;
        };

        const pathFor = (pts: RailPt[], h: number) => {
            const f = (v: number) => Math.round(v * 10) / 10;
            let d = `M ${f(pts[0].cx)} ${f(pts[0].top)}`;
            d += ` L ${f(pts[0].cx)} ${f(pts[0].cy)}`;

            for (let i = 1; i < pts.length; i++) {
                const prev = pts[i - 1];
                const cur = pts[i];

                if (Math.abs(cur.cx - prev.cx) < 0.5) {
                    d += ` L ${f(cur.cx)} ${f(cur.cy)}`;
                    continue;
                }

                /* ------------------------------------------------------------ *
                 * Elbow y-range. Link rows are adjacent 32px boxes (6px pad,
                 * 20px glyphs, 6px pad), so the only glyph-free band across a
                 * boundary is the padding: prev.bottom - 6 .. cur.top + 6,
                 * i.e. 12px for two py-1.5 rows. Keeping the whole S-curve
                 * inside it is what stops the rail from grazing the headings'
                 * text (the old elbow crossed the glyph band).
                 * Re-check these offsets if py-1.5 or the text size changes.
                 * ------------------------------------------------------------ */
                const yA = prev.bottom - 6;
                const yB = cur.top + 6;
                const g = Math.max(1, Math.min(4, (yB - yA) / 2));

                d +=
                    ` L ${f(prev.cx)} ${f(yA)}` +
                    ` C ${f(prev.cx)} ${f(yA + g)} ${f(cur.cx)} ${f(yB - g)} ${f(cur.cx)} ${f(yB)}` +
                    ` L ${f(cur.cx)} ${f(cur.cy)}`;
            }

            d += ` L ${f(pts[pts.length - 1].cx)} ${f(h)}`;

            return d;
        };

        // Rail geometry in svg pixel space, rebuilt whenever the list
        // reflows. Each point keeps its marker-slot center plus the owning
        // link's row bounds, so elbows can anchor to the padding bands.
        // `arcs` caches the arc length at each heading's center — the
        // thumb's reveal edge — so scroll updates never touch geometry.
        let points: RailPt[] = [];
        let svgH = 0;
        let railLen = 0;
        let arcs: number[] = [];

        const layout = () => {
            const svgRect = svg.getBoundingClientRect();
            if (!svgRect.height) {
                // Below `lg` the TOC is display:none and the rect is
                // empty; the thumb update simply no-ops.
                svgH = 0;
                return;
            }

            svgH = svgRect.height;
            svg.setAttribute("viewBox", `0 0 ${svgRect.width} ${svgH}`);

            points = sections.map((section) => {
                const marker = section.marker.getBoundingClientRect();
                const row = section.link.getBoundingClientRect();

                return {
                    cx: marker.left - svgRect.left + marker.width / 2,
                    cy: marker.top - svgRect.top + marker.height / 2,
                    top: row.top - svgRect.top,
                    bottom: row.bottom - svgRect.top,
                };
            });

            const d = pathFor(points, svgH);
            rail.setAttribute("d", d);
            indicator.setAttribute("d", d);

            // The viewBox is 1:1 with the rendered box, so dashes are
            // measured in plain pixels.
            railLen = indicator.getTotalLength();
            if (!railLen) return;

            indicator.setAttribute(
                "stroke-dasharray",
                `${railLen} ${railLen}`,
            );

            // The path's y is strictly increasing toward the bottom
            // (rows descend, elbows dip monotonically), so a binary
            // search lands on each heading's exact arc length. Recomputed
            // only when the list reflows.
            arcs = [];

            for (let i = 0; i < points.length; i++) {
                let lo = 0;
                let hi = railLen;

                for (let k = 0; k < 24; k++) {
                    const mid = (lo + hi) / 2;

                    if (indicator.getPointAtLength(mid).y < points[i].cy) {
                        lo = mid;
                    } else {
                        hi = mid;
                    }
                }

                arcs[i] = (lo + hi) / 2;
            }
        };

        const moveThumb = (section: Section) => {
            if (!svgH || !railLen || arcs.length !== sections.length) return;

            // Reading the tail section fills the rail to the bottom, like
            // a scrollbar hitting the end of its track.
            const isTail = section.index === sections.length - 1;
            const arc = isTail ? railLen : arcs[section.index];

            // Same reveal and no pending snap = nothing to repaint while
            // scrolling within one section.
            if (section.index === last && !snapNext) return;
            last = section.index;

            if (snapNext) indicator.setAttribute("data-instant", "");

            indicator.style.setProperty(
                "stroke-dashoffset",
                `${railLen - arc}px`,
            );

            if (snapNext) {
                // Flush the jump, then let it fade in where it belongs
                // instead of gliding from a stale offset.
                void indicator.getBoundingClientRect();
                indicator.removeAttribute("data-instant");
                snapNext = false;
            }

            indicator.style.opacity = "1";
        };

        const setActive = (section: Section) => {
            if (section !== active) {
                active = section;

                for (const link of links) {
                    if (link === section.link) {
                        link.setAttribute("aria-current", "location");
                    } else {
                        link.removeAttribute("aria-current");
                    }
                }
            }

            moveThumb(section);
        };

        // The last heading that has reached its resting line is the one being
        // read. At the very bottom the final heading always wins, since a
        // short trailing section can never reach that line on its own.
        const currentSection = () => {
            const doc = document.documentElement;
            const atBottom =
                window.scrollY > 0 &&
                window.innerHeight + window.scrollY >= doc.scrollHeight - 2;

            if (atBottom) return sections[sections.length - 1];

            let current = sections[0];

            for (const section of sections) {
                const { top } = section.element.getBoundingClientRect();
                if (top - section.offset > 1) break;
                current = section;
            }

            return current;
        };

        let frame = 0;
        let lock: Section | undefined;
        let lockTimer = 0;

        const releaseLock = () => {
            lock = undefined;
            if (lockTimer) {
                clearTimeout(lockTimer);
                lockTimer = 0;
            }
        };

        const update = () => {
            frame = 0;

            const current = currentSection();

            // While a clicked heading is still being scrolled to, park on the
            // target instead of sweeping through everything in between.
            if (lock) {
                if (current !== lock) return;
                releaseLock();
            }

            setActive(current);
        };

        const schedule = () => {
            if (frame) return;
            frame = requestAnimationFrame(update);
        };

        const remeasure = () => {
            measure();
            layout();

            // Geometry moved underneath the thumb: re-place it without
            // gliding from the old offset.
            snapNext = true;
            schedule();
        };

        const onClick = (event: Event) => {
            const section = sections.find((s) => s.link === event.currentTarget);
            if (!section) return;

            lock = section;
            setActive(section);

            if (lockTimer) clearTimeout(lockTimer);
            // Smooth scrolling may never land exactly; don't stay locked.
            lockTimer = window.setTimeout(releaseLock, 1200);
        };

        for (const { link } of sections) {
            link.addEventListener("click", onClick);
        }

        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", remeasure);

        // Late reflows (images, font swaps) move headings; re-measure so the
        // rectangle and the active heading never drift apart.
        resizeObserver = new ResizeObserver(remeasure);
        resizeObserver.observe(document.body);

        const header = document.querySelector("header");
        if (header) resizeObserver.observe(header);

        measure();
        layout();
        update();

        teardown = () => {
            if (frame) cancelAnimationFrame(frame);
            releaseLock();
            window.removeEventListener("scroll", schedule);
            window.removeEventListener("resize", remeasure);

            for (const { link } of sections) {
                link.removeEventListener("click", onClick);
            }
        };
    }

    document.addEventListener("astro:page-load", initScrollspy);
    document.addEventListener("astro:before-swap", () => {
        teardown?.();
        teardown = undefined;
        resizeObserver?.disconnect();
    });
</script>

