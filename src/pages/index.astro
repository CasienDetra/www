---
import Section from "@/components/static/Section.astro";
import Introduction from "@/components/static/Introduction.astro";
import Intro from "@/components/static/Intro.astro";
import site_config from "@/site-config.json";
import Activity from "@/components/static/Activity.astro";
import FeaturedBlog from "@/components/static/FeaturedBlog.astro";
import FeaturedProject from "@/components/static/FeaturedProject.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const structuredData = [{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: Astro.site?.href,
    name: "Yanouk — Software Developer in Cambodia",
    mainEntity: {
        "@type": "Person",
        "@id": new URL("#person", Astro.site).href,
        name: site_config.introduction.heading,
        url: Astro.site?.href,
        description: site_config.introduction.description,
        jobTitle: "Software Developer",
        sameAs: site_config.introduction.socialItems
            .filter((item) => item.type === "github")
            .map((item) => item.url),
    },
}];
---

<BaseLayout title="Yanouk — Software Developer in Cambodia" description="Software developer based in Phnom Penh, Cambodia. Explore my open-source projects, developer tools, and practical guides on building software." image="/og/default.png" structuredData={structuredData}>
    <div transition:animate="fade" class="pt-10">
        {/* Intro Section */}
        {site_config.bIntro && <Intro />}

        {/* Introduction Section */}
        {site_config.bIntroduction && <Introduction />}

        {/* Activity Section */}
        {site_config.bActivity && <Activity />}

        {
            site_config.featured.important === "project" ? (
                <>
                    <FeaturedProject />
                    <FeaturedBlog />
                </>
            ) : (
                <>
                    <FeaturedBlog />
                    <FeaturedProject />
                </>
            )
        }
    </div>
</BaseLayout>
